{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Projet RGL",
  "type": "object",
  "required": [
    "name",
    "version",
    "rgl"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "rgl": {
      "const": "0"
    },
    "safe": {
      "type": "boolean",
      "default": false
    },
    "overflow": {
      "enum": [
        "checked",
        "unchecked"
      ],
      "default": "checked"
    },
    "recursion": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "infinite"
        }
      ]
    },
    "loop": {
      "enum": [
        "free",
        "safe"
      ]
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Fichiers et motifs relatifs copiés dans out/debug ou out/release en conservant leur chemin. Exemple : front/html/**."
    },
    "no-trust": {
      "type": "boolean",
      "default": false,
      "description": "Interdit les appels et références @trusted hors std et cpp-trust."
    },
    "no-cpp": {
      "type": "boolean",
      "default": false,
      "description": "Interdit les blocs cpp et les liaisons natives hors std et cpp-trust."
    },
    "cpp-trust": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "\\.forge$"
      },
      "description": "Fichiers .forge autorisés, par chemins relatifs à la racine, sans autorisation transitive des imports."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Ce que fait le paquet (manifeste d'un paquet)."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "La licence du paquet, par exemple MIT."
    },
    "dependencies": {
      "type": "object",
      "description": "Les paquets demandés : l'adresse du dépôt et sa version exacte. `rgl add` les écrit.",
      "propertyNames": {
        "pattern": "^(github\\.com|gitlab\\.com|codeberg\\.org)/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
        "description": "Une version exacte : trois nombres, sans intervalle ni préfixe."
      },
      "examples": [
        {
          "github.com/alice/json": "1.2.0"
        }
      ]
    },
    "package-trust": {
      "type": "object",
      "description": "Ce que le projet autorise à ses paquets ; seul le projet racine autorise.",
      "properties": {
        "binaries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(github\\.com|gitlab\\.com|codeberg\\.org)/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
          },
          "description": "Paquets qui gardent leurs bibliothèques précompilées (dll, so, dylib, a, lib, obj, o) à l'extraction."
        },
        "cpp": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(github\\.com|gitlab\\.com|codeberg\\.org)/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
          },
          "description": "Paquets dont le C++ est admis (blocs cpp, .rgl.cpp, descriptors, forge: native)."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
