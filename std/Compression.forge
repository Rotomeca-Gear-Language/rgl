    static bool inflate_raw(const Bytes& data, std::size_t from, std::size_t to, Bytes& out, std::size_t* consumed) {
        BitReader r(data, from, to);
        bool last;
        do {
            last = r.bits(1) != 0;
            const std::uint32_t type = r.bits(2);
            if (r.failed) return false;
            if (type == 0) {
                r.buffer = 0; r.count = 0;
                if (r.position + 4 > to) return false;
                const std::size_t len = data[r.position] | (data[r.position + 1] << 8);
                const std::size_t nlen = data[r.position + 2] | (data[r.position + 3] << 8);
                if ((len ^ 0xFFFF) != nlen) return false;
                r.position += 4;
                if (r.position + len > to) return false;
                out.insert(out.end(), data.begin() + r.position, data.begin() + r.position + len);
                r.position += len;
            } else if (type == 1) {
                std::uint8_t lengths[320];
                int i = 0;
                for (; i < 144; ++i) lengths[i] = 8;
                for (; i < 256; ++i) lengths[i] = 9;
                for (; i < 280; ++i) lengths[i] = 7;
                for (; i < 288; ++i) lengths[i] = 8;
                Huffman lit, dist;
                build(lit, lengths, 288);
                for (i = 0; i < 30; ++i) lengths[i] = 5;
                build(dist, lengths, 30);
                if (!inflate_codes(r, out, lit, dist)) return false;
            } else if (type == 2) {
                const int hlit = static_cast<int>(r.bits(5)) + 257, hdist = static_cast<int>(r.bits(5)) + 1, hclen = static_cast<int>(r.bits(4)) + 4;
                if (r.failed || hlit > 286 || hdist > 30) return false;
                static const std::uint8_t order[19] = {16,17,18,0,8,7,9,6,10,5,11,4,12,3,13,2,14,1,15};
                std::uint8_t lengths[320] = {0};
                for (int i = 0; i < hclen; ++i) lengths[order[i]] = static_cast<std::uint8_t>(r.bits(3));
                Huffman lencode;
                build(lencode, lengths, 19);
                std::uint8_t all[320] = {0};
                int index = 0;
                while (index < hlit + hdist) {
                    const int symbol = decode(r, lencode);
                    if (symbol < 0) return false;
                    if (symbol < 16) all[index++] = static_cast<std::uint8_t>(symbol);
                    else {
                        int repeat, value = 0;
                        if (symbol == 16) { if (index == 0) return false; value = all[index - 1]; repeat = 3 + static_cast<int>(r.bits(2)); }
                        else if (symbol == 17) repeat = 3 + static_cast<int>(r.bits(3));
                        else repeat = 11 + static_cast<int>(r.bits(7));
                        if (index + repeat > hlit + hdist) return false;
                        while (repeat--) all[index++] = static_cast<std::uint8_t>(value);
                    }
                }
                Huffman lit, dist;
                build(lit, all, hlit);
                build(dist, all + hlit, hdist);
                if (!inflate_codes(r, out, lit, dist)) return false;
            } else return false;
        } while (!last);
        if (consumed) *consumed = r.position;
        return true;
    }

    // ---- Compression : LZ77 puis codes de Huffman fixes
    struct BitWriter {
        Bytes out; std::uint32_t buffer = 0; int count = 0;
        void bits(std::uint32_t value, int n) {
            buffer |= value << count; count += n;
            while (count >= 8) { out.push_back(static_cast<std::uint8_t>(buffer & 0xFF)); buffer >>= 8; count -= 8; }
        }
        void code(std::uint32_t value, int n) { std::uint32_t r = 0; for (int i = 0; i < n; ++i) r |= ((value >> i) & 1u) << (n - 1 - i); bits(r, n); }
        void flush() { if (count > 0) { out.push_back(static_cast<std::uint8_t>(buffer & 0xFF)); buffer = 0; count = 0; } }
    };
    static void put_literal(BitWriter& w, int v) {
        if (v < 144) w.code(0x30 + v, 8);
        else if (v < 256) w.code(0x190 + (v - 144), 9);
        else if (v < 280) w.code(v - 256, 7);
        else w.code(0xC0 + (v - 280), 8);
    }
    static Bytes deflate_raw(const Bytes& data) {
        BitWriter w;
        w.bits(1, 1); w.bits(1, 2);
        std::vector<std::int32_t> head(1 << 15, -1), prev(data.size(), -1);
        const auto hash = [&](std::size_t i) { return ((data[i] << 10) ^ (data[i + 1] << 5) ^ data[i + 2]) & 0x7FFF; };
        std::size_t i = 0;
        while (i < data.size()) {
            std::size_t best_length = 0, best_distance = 0;
            if (i + 2 < data.size()) {
                const int h = hash(i);
                std::int32_t candidate = head[h];
                int chain = 64;
                while (candidate >= 0 && chain-- > 0 && i - static_cast<std::size_t>(candidate) <= 32768) {
                    std::size_t length = 0;
                    while (length < 258 && i + length < data.size() && data[candidate + length] == data[i + length]) ++length;
                    if (length > best_length) { best_length = length; best_distance = i - candidate; if (length == 258) break; }
                    candidate = prev[candidate];
                }
            }
            const auto insert = [&](std::size_t p) { if (p + 2 < data.size()) { const int h = hash(p); prev[p] = head[h]; head[h] = static_cast<std::int32_t>(p); } };
            if (best_length >= 3) {
                int s = 28;
                while (length_base[s] > best_length) --s;
                put_literal(w, 257 + s);
                w.bits(static_cast<std::uint32_t>(best_length - length_base[s]), length_extra[s]);
                int d = 29;
                while (distance_base[d] > best_distance) --d;
                w.code(static_cast<std::uint32_t>(d), 5);
                w.bits(static_cast<std::uint32_t>(best_distance - distance_base[d]), distance_extra[d]);
                for (std::size_t k = 0; k < best_length; ++k) insert(i + k);
                i += best_length;
            } else {
                put_literal(w, data[i]);
                insert(i);
                ++i;
            }
        }
        put_literal(w, 256);
        w.flush();
        return w.out;
    }
    rgl_return rgl(rgl_arg_data data) {
        const Bytes input = to_vector(data);
        Bytes result = {0x1f, 0x8b, 8, 0, 0, 0, 0, 0, 0, 0xff};
        const Bytes body = deflate_raw(input);
        result.insert(result.end(), body.begin(), body.end());
        const std::uint32_t crc = crc32_of(input, 0, input.size());
        const std::uint32_t size = static_cast<std::uint32_t>(input.size());
        for (int i = 0; i < 4; ++i) result.push_back(static_cast<std::uint8_t>(crc >> (i * 8)));
        for (int i = 0; i < 4; ++i) result.push_back(static_cast<std::uint8_t>(size >> (i * 8)));
        return to_array(result);
    }
}(bytes data: data): bytes;

