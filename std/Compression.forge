        if (flags & 4) { if (position + 2 > input.size()) return rgl_return{}; position += 2 + (input[position] | (input[position + 1] << 8)); }
        if (flags & 8) { while (position < input.size() && input[position] != 0) ++position; ++position; }
        if (flags & 16) { while (position < input.size() && input[position] != 0) ++position; ++position; }
        if (flags & 2) position += 2;
        if (position + 8 > input.size()) return rgl_return{};
        Bytes result;
        std::size_t used = 0;
        if (!inflate_raw(input, position, input.size() - 8, result, &used)) return rgl_return{};
        const std::size_t tail = input.size() - 8;
        std::uint32_t crc = 0, size = 0;
        for (int i = 0; i < 4; ++i) { crc |= static_cast<std::uint32_t>(input[tail + i]) << (i * 8); size |= static_cast<std::uint32_t>(input[tail + 4 + i]) << (i * 8); }
        if (crc != crc32_of(result, 0, result.size()) || size != static_cast<std::uint32_t>(result.size())) return rgl_return{};
        return rgl_return(to_array(result));
    }
}(bytes data: data): bytes?;
