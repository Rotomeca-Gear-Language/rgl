forge: gears
description: "Fuseaux horaires : décalage, heure d'été et conversions, sans rien demander au système"

export {TimeZone, LocalTime, timeZone, utcZone, fixedOffset, zoneNames, utcOffset, isDaylightSaving, localTime, inZone, fromZone, formatIso};

