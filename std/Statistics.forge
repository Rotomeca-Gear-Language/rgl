forge: gears
description: "Aides internes aux statistiques sur des tableaux de nombres"

/// <lang name="fr">
/// <summary>Le tableau de flottants trié du plus petit au plus grand, sans toucher à l'original (usage interne des statistiques).</summary>
/// <param name="values">Les valeurs à trier.</param>
/// <returns>Un nouveau tableau trié.</returns>
/// </lang>
/// <lang name="en">
/// <summary>The array of floats sorted in ascending order, leaving the original untouched (internal use of the statistics).</summary>
/// <param name="values">The values to sort.</param>
/// <returns>A new sorted array.</returns>
/// </lang>
@trusted
gear pure _sortedDoubles([double] values): [double] => cpp {
    #include <algorithm>
    #include <vector>
    rgl_return rgl(rgl_arg_values values) {
        std::vector<double> sorted(values.size());
        for (std::size_t i = 0; i < values.size(); ++i) sorted[i] = values[i];
        std::sort(sorted.begin(), sorted.end());
        rgl_return result;
        result.reserve(sorted.size());
        for (const double value : sorted) result.push(value);
        return result;
    }
}([double] values: values): [double];

/// <lang name="fr">
/// <summary>Le rang `p` pour cent d'un tableau trié, par interpolation linéaire entre les deux valeurs voisines.</summary>
/// <param name="sorted">Les valeurs, déjà triées.</param>
/// <param name="p">Le pourcentage, de 0 à 100 (borné).</param>
/// <returns>La valeur, ou `null` pour un tableau vide.</returns>
/// </lang>
/// <lang name="en">
/// <summary>The `p` percent rank of a sorted array, by linear interpolation between the two neighbouring values.</summary>
/// <param name="sorted">The values, already sorted.</param>
/// <param name="p">The percentage, from 0 to 100 (clamped).</param>
/// <returns>The value, or `null` for an empty array.</returns>
/// </lang>
gear pure _percentileOf([double] sorted, double p): double? {
    if (sorted.length eq 0) { return null; }
    const double clamped: p < 0.0 ? 0.0 : (p > 100.0 ? 100.0 : p);
    const double position: clamped / 100.0 * ((sorted.length - 1) as double);
    const long below: position as long;
    const long above: below + 1 < (sorted.length as long) ? below + 1 : below;
    const double fraction: position - (below as double);
    return sorted[below] + (sorted[above] - sorted[below]) * fraction;
}

/// <lang name="fr">
/// <summary>La variance d'un tableau de flottants : la moyenne des carrés des écarts à la moyenne (usage interne).</summary>
/// <param name="values">Les valeurs.</param>
/// <param name="sample">`true` divise par n - 1 (échantillon) au lieu de n (population).</param>
/// <returns>La variance, ou `null` s'il n'y a pas assez de valeurs.</returns>
/// </lang>
/// <lang name="en">
/// <summary>The variance of an array of floats: the mean of the squared deviations from the mean (internal use).</summary>
/// <param name="values">The values.</param>
/// <param name="sample">`true` divides by n - 1 (sample) instead of n (population).</param>
/// <returns>The variance, or `null` when there are not enough values.</returns>
/// </lang>
gear pure _varianceOf([double] values, bool sample): double? {
    const long count: values.length as long;
    if (count eq 0 or (sample and count eq 1)) { return null; }
    const double mean: (values |+> 0.0 with (acc, x) => acc + x) / (count as double);
    const double squares: values |+> 0.0 with (acc, x) => acc + (x - mean) * (x - mean);
    return squares / ((sample ? count - 1 : count) as double);
}
