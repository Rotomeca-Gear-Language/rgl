        for (; i < text.size(); ++i) if (text.data()[i] < '0' || text.data()[i] > '9') return false;
        while (start + 1 < text.size() && text.data()[start] == '0') ++start;
        out.digits.assign(text.data() + start, text.size() - start);
        if (out.digits == "0") out.negative = false;
        return true;
    }
    static int compare_magnitude(const std::string& a, const std::string& b) {
        if (a.size() != b.size()) return a.size() < b.size() ? -1 : 1;
        const int c = a.compare(b);
        return c < 0 ? -1 : (c > 0 ? 1 : 0);
    }
    static std::string add_magnitude(const std::string& a, const std::string& b) {
        std::string result;
        int carry = 0;
        for (std::size_t i = 0; i < a.size() || i < b.size() || carry; ++i) {
            int sum = carry;
            if (i < a.size()) sum += a[a.size() - 1 - i] - '0';
            if (i < b.size()) sum += b[b.size() - 1 - i] - '0';
            result += static_cast<char>('0' + sum % 10);
            carry = sum / 10;
        }
        std::reverse(result.begin(), result.end());
        return result.empty() ? "0" : result;
    }
    static std::string sub_magnitude(const std::string& a, const std::string& b) {
        // a >= b
        std::string result;
        int borrow = 0;
        for (std::size_t i = 0; i < a.size(); ++i) {
            int diff = (a[a.size() - 1 - i] - '0') - borrow - (i < b.size() ? b[b.size() - 1 - i] - '0' : 0);
            borrow = diff < 0 ? 1 : 0;
            if (diff < 0) diff += 10;
            result += static_cast<char>('0' + diff);
        }
        while (result.size() > 1 && result.back() == '0') result.pop_back();
        std::reverse(result.begin(), result.end());
        return result;
    }
    static std::string mul_magnitude(const std::string& a, const std::string& b) {
        if (a == "0" || b == "0") return "0";
        std::vector<int> cells(a.size() + b.size(), 0);
        for (std::size_t i = 0; i < a.size(); ++i)
            for (std::size_t j = 0; j < b.size(); ++j)
                cells[i + j + 1] += (a[i] - '0') * (b[j] - '0');
        for (std::size_t k = cells.size(); k-- > 1;) { cells[k - 1] += cells[k] / 10; cells[k] %= 10; }
        std::string result;
        std::size_t start = 0;
        while (start + 1 < cells.size() && cells[start] == 0) ++start;
        for (std::size_t k = start; k < cells.size(); ++k) result += static_cast<char>('0' + cells[k]);
        return result;
    }
    static void divmod_magnitude(const std::string& a, const std::string& b, std::string& quotient, std::string& remainder) {
        quotient.clear();
        remainder = "0";
        for (const char digit : a) {
            remainder = remainder == "0" ? std::string(1, digit) : remainder + digit;
            int count = 0;
            while (compare_magnitude(remainder, b) >= 0) { remainder = sub_magnitude(remainder, b); ++count; }
            quotient += static_cast<char>('0' + count);
        }
        std::size_t start = 0;
        while (start + 1 < quotient.size() && quotient[start] == '0') ++start;
        quotient = quotient.empty() ? "0" : quotient.substr(start);
    }
    static std::string render(bool negative, const std::string& digits) {
        return (negative && digits != "0" ? "-" : "") + digits;
    }
    static rgl::standard::string to_rgl(const std::string& text) { return rgl::standard::string(text.c_str(), text.size()); }
    rgl_return rgl(rgl_arg_a a, rgl_arg_b b) {
        Big x, y;
        if (!parse_big(a, x) || !parse_big(b, y)) return rgl_return{};
        return rgl_return(to_rgl(render(x.negative != y.negative, mul_magnitude(x.digits, y.digits))));
    }
}(string a: a, string b: b): string?;

/// <lang name="fr">
/// <summary>Divise deux entiers de taille quelconque (quotient tronqué vers zéro, le reste a le signe du dividende).</summary>
/// <param name="a">Le dividende.</param>
/// <param name="b">Le diviseur.</param>
/// <returns>Un tableau `[quotient, reste]`, `null` si un texte n'est pas un entier ou si le diviseur est nul.</returns>
/// </lang>
/// <lang name="en">
/// <summary>Divides two arbitrary-size integers (quotient truncated toward zero, the remainder has the sign of the dividend).</summary>
/// <param name="a">The dividend.</param>
/// <param name="b">The divisor.</param>
/// <returns>An array `[quotient, remainder]`, `null` when a text is not an integer or the divisor is zero.</returns>
/// </lang>
@trusted
gear pure bigDivMod(string a, string b): [string]? => cpp {
    #include <string>
    #include <vector>
    #include <algorithm>
    struct Big { bool negative = false; std::string digits; };
    static bool parse_big(const rgl::standard::string& text, Big& out) {
        std::size_t i = 0;
        out.negative = false;
        if (i < text.size() && (text.data()[i] == '-' || text.data()[i] == '+')) { out.negative = text.data()[i] == '-'; ++i; }
        if (i >= text.size()) return false;
        std::size_t start = i;
        for (; i < text.size(); ++i) if (text.data()[i] < '0' || text.data()[i] > '9') return false;
        while (start + 1 < text.size() && text.data()[start] == '0') ++start;
        out.digits.assign(text.data() + start, text.size() - start);
        if (out.digits == "0") out.negative = false;
        return true;
    }
    static int compare_magnitude(const std::string& a, const std::string& b) {
        if (a.size() != b.size()) return a.size() < b.size() ? -1 : 1;
        const int c = a.compare(b);
        return c < 0 ? -1 : (c > 0 ? 1 : 0);
    }
    static std::string add_magnitude(const std::string& a, const std::string& b) {
        std::string result;
        int carry = 0;
        for (std::size_t i = 0; i < a.size() || i < b.size() || carry; ++i) {
            int sum = carry;
            if (i < a.size()) sum += a[a.size() - 1 - i] - '0';
            if (i < b.size()) sum += b[b.size() - 1 - i] - '0';
            result += static_cast<char>('0' + sum % 10);
            carry = sum / 10;
        }
        std::reverse(result.begin(), result.end());
        return result.empty() ? "0" : result;
    }
    static std::string sub_magnitude(const std::string& a, const std::string& b) {
        // a >= b
        std::string result;
        int borrow = 0;
        for (std::size_t i = 0; i < a.size(); ++i) {
            int diff = (a[a.size() - 1 - i] - '0') - borrow - (i < b.size() ? b[b.size() - 1 - i] - '0' : 0);
            borrow = diff < 0 ? 1 : 0;
            if (diff < 0) diff += 10;
            result += static_cast<char>('0' + diff);
        }
        while (result.size() > 1 && result.back() == '0') result.pop_back();
        std::reverse(result.begin(), result.end());
        return result;
    }
    static std::string mul_magnitude(const std::string& a, const std::string& b) {
        if (a == "0" || b == "0") return "0";
        std::vector<int> cells(a.size() + b.size(), 0);
        for (std::size_t i = 0; i < a.size(); ++i)
            for (std::size_t j = 0; j < b.size(); ++j)
                cells[i + j + 1] += (a[i] - '0') * (b[j] - '0');
        for (std::size_t k = cells.size(); k-- > 1;) { cells[k - 1] += cells[k] / 10; cells[k] %= 10; }
        std::string result;
        std::size_t start = 0;
        while (start + 1 < cells.size() && cells[start] == 0) ++start;
        for (std::size_t k = start; k < cells.size(); ++k) result += static_cast<char>('0' + cells[k]);
        return result;
    }
    static void divmod_magnitude(const std::string& a, const std::string& b, std::string& quotient, std::string& remainder) {
        quotient.clear();
        remainder = "0";
        for (const char digit : a) {
            remainder = remainder == "0" ? std::string(1, digit) : remainder + digit;
            int count = 0;
            while (compare_magnitude(remainder, b) >= 0) { remainder = sub_magnitude(remainder, b); ++count; }
            quotient += static_cast<char>('0' + count);
        }
        std::size_t start = 0;
        while (start + 1 < quotient.size() && quotient[start] == '0') ++start;
        quotient = quotient.empty() ? "0" : quotient.substr(start);
    }
    static std::string render(bool negative, const std::string& digits) {
        return (negative && digits != "0" ? "-" : "") + digits;
    }
    static rgl::standard::string to_rgl(const std::string& text) { return rgl::standard::string(text.c_str(), text.size()); }
    rgl_return rgl(rgl_arg_a a, rgl_arg_b b) {
        Big x, y;
        if (!parse_big(a, x) || !parse_big(b, y) || y.digits == "0") return rgl_return{};
        std::string quotient, remainder;
        divmod_magnitude(x.digits, y.digits, quotient, remainder);
        rgl::standard::array<rgl::standard::string> result;
        result.push(to_rgl(render(x.negative != y.negative, quotient)));
        result.push(to_rgl(render(x.negative, remainder)));
        return rgl_return(std::move(result));
    }
}(string a: a, string b: b): [string]?;

/// <lang name="fr">
/// <summary>Compare deux entiers de taille quelconque écrits en décimal.</summary>
/// <param name="a">Le premier entier.</param>
/// <param name="b">Le second entier.</param>
/// <returns>-1, 0 ou 1 ; `null` si un texte n'est pas un entier.</returns>
/// </lang>
/// <lang name="en">
/// <summary>Compares two arbitrary-size integers written in decimal.</summary>
/// <param name="a">The first integer.</param>
/// <param name="b">The second integer.</param>
/// <returns>-1, 0 or 1; `null` when a text is not an integer.</returns>
/// </lang>
@trusted
gear pure bigCompare(string a, string b): int? => cpp {
    #include <string>
    #include <vector>
    #include <algorithm>
    struct Big { bool negative = false; std::string digits; };
    static bool parse_big(const rgl::standard::string& text, Big& out) {
        std::size_t i = 0;
        out.negative = false;
        if (i < text.size() && (text.data()[i] == '-' || text.data()[i] == '+')) { out.negative = text.data()[i] == '-'; ++i; }
        if (i >= text.size()) return false;
        std::size_t start = i;
        for (; i < text.size(); ++i) if (text.data()[i] < '0' || text.data()[i] > '9') return false;
        while (start + 1 < text.size() && text.data()[start] == '0') ++start;
        out.digits.assign(text.data() + start, text.size() - start);
        if (out.digits == "0") out.negative = false;
        return true;
    }
    static int compare_magnitude(const std::string& a, const std::string& b) {
        if (a.size() != b.size()) return a.size() < b.size() ? -1 : 1;
        const int c = a.compare(b);
        return c < 0 ? -1 : (c > 0 ? 1 : 0);
    }
    static std::string add_magnitude(const std::string& a, const std::string& b) {
        std::string result;
        int carry = 0;
        for (std::size_t i = 0; i < a.size() || i < b.size() || carry; ++i) {
            int sum = carry;
            if (i < a.size()) sum += a[a.size() - 1 - i] - '0';
            if (i < b.size()) sum += b[b.size() - 1 - i] - '0';
            result += static_cast<char>('0' + sum % 10);
            carry = sum / 10;
        }
        std::reverse(result.begin(), result.end());
        return result.empty() ? "0" : result;
    }
    static std::string sub_magnitude(const std::string& a, const std::string& b) {
        // a >= b
        std::string result;
        int borrow = 0;
        for (std::size_t i = 0; i < a.size(); ++i) {
            int diff = (a[a.size() - 1 - i] - '0') - borrow - (i < b.size() ? b[b.size() - 1 - i] - '0' : 0);
            borrow = diff < 0 ? 1 : 0;
            if (diff < 0) diff += 10;
            result += static_cast<char>('0' + diff);
        }
        while (result.size() > 1 && result.back() == '0') result.pop_back();
        std::reverse(result.begin(), result.end());
        return result;
    }
    static std::string mul_magnitude(const std::string& a, const std::string& b) {
        if (a == "0" || b == "0") return "0";
        std::vector<int> cells(a.size() + b.size(), 0);
        for (std::size_t i = 0; i < a.size(); ++i)
            for (std::size_t j = 0; j < b.size(); ++j)
                cells[i + j + 1] += (a[i] - '0') * (b[j] - '0');
        for (std::size_t k = cells.size(); k-- > 1;) { cells[k - 1] += cells[k] / 10; cells[k] %= 10; }
        std::string result;
        std::size_t start = 0;
        while (start + 1 < cells.size() && cells[start] == 0) ++start;
        for (std::size_t k = start; k < cells.size(); ++k) result += static_cast<char>('0' + cells[k]);
        return result;
    }
    static void divmod_magnitude(const std::string& a, const std::string& b, std::string& quotient, std::string& remainder) {
        quotient.clear();
        remainder = "0";
        for (const char digit : a) {
            remainder = remainder == "0" ? std::string(1, digit) : remainder + digit;
            int count = 0;
            while (compare_magnitude(remainder, b) >= 0) { remainder = sub_magnitude(remainder, b); ++count; }
            quotient += static_cast<char>('0' + count);
        }
        std::size_t start = 0;
        while (start + 1 < quotient.size() && quotient[start] == '0') ++start;
        quotient = quotient.empty() ? "0" : quotient.substr(start);
    }
    static std::string render(bool negative, const std::string& digits) {
        return (negative && digits != "0" ? "-" : "") + digits;
    }
    static rgl::standard::string to_rgl(const std::string& text) { return rgl::standard::string(text.c_str(), text.size()); }
    rgl_return rgl(rgl_arg_a a, rgl_arg_b b) {
        Big x, y;
        if (!parse_big(a, x) || !parse_big(b, y)) return rgl_return{};
        if (x.negative != y.negative) return rgl_return(x.negative ? -1 : 1);
        const int order = compare_magnitude(x.digits, y.digits);
        return rgl_return(x.negative ? -order : order);
    }
}(string a: a, string b: b): int?;

/// <lang name="fr">
/// <summary>La puissance d'un entier de taille quelconque.</summary>
/// <param name="base">L'entier, en décimal.</param>
/// <param name="exponent">L'exposant.</param>
/// <returns>`base` puissance `exponent` en décimal, `null` si `base` n'est pas un entier.</returns>
/// </lang>
/// <lang name="en">
/// <summary>The power of an arbitrary-size integer.</summary>
/// <param name="base">The integer, in decimal.</param>
/// <param name="exponent">The exponent.</param>
/// <returns>`base` raised to `exponent` in decimal, `null` when `base` is not an integer.</returns>
/// </lang>
gear pure bigPow(string base, uint exponent): string? {
    if (exponent eq 0) { return '1'; }
    const string? half: bigPow(base, exponent / 2);
    const string? square: half eq null ? null : bigMul(half ?? '', half ?? '');
    return exponent % 2 eq 0 ? square : (square eq null ? null : bigMul(square ?? '', base));
}

/// <lang name="fr">
/// <summary>La factorielle d'un entier, en décimal et sans débordement.</summary>
/// <param name="n">L'entier (au plus quelques milliers).</param>
/// <returns>n! en décimal.</returns>
/// </lang>
/// <lang name="en">
/// <summary>The factorial of an integer, in decimal and without overflow.</summary>
/// <param name="n">The integer (at most a few thousand).</param>
/// <returns>n! in decimal.</returns>
/// </lang>
gear pure bigFactorial(uint n): string {
    if (n < 2) { return '1'; }
    return [2..n] |+> '1' with (acc, k) => bigMul(acc, `{k}`) ?? acc;
}
