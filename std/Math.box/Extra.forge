forge: gears
description: "Mathématiques supplémentaires : flottants spéciaux, trigonométrie hyperbolique, divisions entières, nombres premiers, grands entiers"

/// <lang name="fr">
/// <summary>Indique si le flottant n'est pas un nombre (NaN).</summary>
/// <param name="x">Le nombre.</param>
/// <returns>`true` pour NaN.</returns>
/// </lang>
/// <lang name="en">
/// <summary>Checks whether the float is not a number (NaN).</summary>
/// <param name="x">The number.</param>
/// <returns>`true` for NaN.</returns>
/// </lang>
@trusted
gear pure isNaN(double x): bool => cpp {
    #include <cmath>
    rgl_return rgl(rgl_arg_x x) {
        return std::isnan(x);
    }
}(double x: x): bool;

/// <lang name="fr">
/// <summary>Indique si le flottant est infini (positif ou négatif).</summary>
/// <param name="x">Le nombre.</param>
/// <returns>`true` pour l'infini.</returns>
/// </lang>
/// <lang name="en">
/// <summary>Checks whether the float is infinite (positive or negative).</summary>
/// <param name="x">The number.</param>
/// <returns>`true` for infinity.</returns>
/// </lang>
@trusted
gear pure isInfinity(double x): bool => cpp {
    #include <cmath>
    rgl_return rgl(rgl_arg_x x) {
        return std::isinf(x);
    }
}(double x: x): bool;

/// <lang name="fr">
/// <summary>Indique si le flottant est un nombre fini (ni infini ni NaN).</summary>
/// <param name="x">Le nombre.</param>
/// <returns>`true` pour un nombre fini.</returns>
/// </lang>
/// <lang name="en">
/// <summary>Checks whether the float is a finite number (neither infinite nor NaN).</summary>
/// <param name="x">The number.</param>
/// <returns>`true` for a finite number.</returns>
/// </lang>
@trusted
gear pure isFinite(double x): bool => cpp {
    #include <cmath>
    rgl_return rgl(rgl_arg_x x) {
        return std::isfinite(x);
    }
}(double x: x): bool;

