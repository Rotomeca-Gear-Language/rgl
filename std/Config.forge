gear pure parseToml(string text): [string:string] ! ParseError {
    const [string] flat: _parseToml(text);
    if (flat.length eq 0) { return err({message: 'TOML invalide', input: text}); }
    if (flat[0] not eq '') { return err({message: flat[0], input: text}); }
    [string:string] none: [:];
    return ok([1..<flat.length by 2] |+> none with (acc, i) => acc.put(flat[i], flat[i + 1]));
}

/// <lang name="fr">
/// <summary>Lit un texte YAML et le range à plat : chaque clé est le chemin de la valeur (`a.b`, `liste[0]`) et chaque valeur son texte.</summary>
/// <param name="text">Le texte YAML.</param>
/// <returns>Le dictionnaire à clés pointées, ou une `ParseError` qui donne la ligne et la raison.</returns>
/// </lang>
/// <lang name="en">
/// <summary>Reads YAML text into a flat dictionary: each key is the path of the value (`a.b`, `list[0]`) and each value its text.</summary>
/// <param name="text">The YAML text.</param>
/// <returns>The dotted-key dictionary, or a `ParseError` giving the line and the reason.</returns>
/// </lang>
gear pure parseYaml(string text): [string:string] ! ParseError {
    const [string] flat: _parseYaml(text);
    if (flat.length eq 0) { return err({message: 'YAML invalide', input: text}); }
    if (flat[0] not eq '') { return err({message: flat[0], input: text}); }
    [string:string] none: [:];
    return ok([1..<flat.length by 2] |+> none with (acc, i) => acc.put(flat[i], flat[i + 1]));
}

/// <lang name="fr">
/// <summary>Écrit un dictionnaire à clés pointées en INI : la partie avant le dernier point est la section, le reste la clé.</summary>
/// <param name="values">Les valeurs, par clé pointée (`section.cle`).</param>
/// <returns>Le texte INI : les clés sans section d'abord, puis chaque section.</returns>
/// </lang>
/// <lang name="en">
/// <summary>Writes a dotted-key dictionary as INI: the part before the last dot is the section, the rest is the key.</summary>
/// <param name="values">The values, by dotted key (`section.key`).</param>
/// <returns>The INI text: keys without a section first, then each section.</returns>
/// </lang>
gear pure toIni([string:string] values): string {
    const [string] keys: values.keys();
    const string head: keys |+> '' with (acc, key) => key.contains('.') ? acc : `{acc}{key}={values[key]}\n`;
    const [string] noSections: [];
    const [string] sections: keys |+> noSections with (acc, key) => {
        const long dot: key.lastIndexOf('.') ?? -1;
        const string section: dot < 0 ? '' : key.substring(0, dot);
        return (dot < 0 or acc.contains(section)) ? acc : [...acc, section];
    };
    return sections |+> head with (acc, section) =>
        `{acc}{acc.isEmpty() ? '' : "\n"}[{section}]\n` + (keys |+> '' with (inner, key) => {
            const long dot: key.lastIndexOf('.') ?? -1;
            return (dot >= 0 and key.substring(0, dot) eq section) ? `{inner}{key.substring(dot + 1, key.length as long)}={values[key]}\n` : inner;
        });
}
